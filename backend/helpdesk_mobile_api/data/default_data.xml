<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Configuration parameters for mobile API -->
        <record id="param_reopen_window_days" model="ir.config_parameter">
            <field name="key">helpdesk_mobile.reopen_window_days</field>
            <field name="value">7</field>
        </record>
        <record id="param_max_attachment_size_mb" model="ir.config_parameter">
            <field name="key">helpdesk_mobile.max_attachment_size_mb</field>
            <field name="value">10</field>
        </record>
        <record id="param_max_attachments_count" model="ir.config_parameter">
            <field name="key">helpdesk_mobile.max_attachments_count</field>
            <field name="value">5</field>
        </record>
    </data>
</odoo>
